{
  "expo": {
    "name": "StartupHub",
    "slug": "startuphub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.startuphub.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Необходим для загрузки фото профиля и проектов",
        "NSPhotoLibraryUsageDescription": "Необходим для выбора изображений из галереи"
      }
    },
    "android": {
      "package": "com.startuphub.app",
      "versionCode": 1,
      "permissions": ["INTERNET"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_PROJECT_ID_HERE"
      }
    }
  }
}
